{
  "manifest_version": 3,
  "name": "PoEHelper Wealthy Exile Sync",
  "version": "0.1.0",
  "description": "Sync stash rows from Wealthy Exile into a local PoEHelper instance.",
  "permissions": ["tabs", "scripting", "storage", "downloads", "webRequest", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://wealthyexile.com/*", "https://*.wealthyexile.com/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5173/*"]
  },
  "background": {
    "service_worker": "background.js"
  }
}
